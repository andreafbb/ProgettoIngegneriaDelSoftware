<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="boundary.FormGestioneRegistro">
  <grid id="root2" binding="panel1" default-binding="true" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="15">
    <margin top="25" left="30" bottom="25" right="30"/>
    <constraints>
      <xy x="20" y="20" width="600" height="450"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="btnBack2" class="javax.swing.JButton" binding="buttonBack">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="80" height="24"/>
          </grid>
        </constraints>
        <properties>
          <font name="SansSerif" size="12"/>
          <text value="Indietro"/>
        </properties>
      </component>
      <grid id="togglebar1" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="true" same-size-vertically="false" hgap="15" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tgAgg1" class="javax.swing.JToggleButton" binding="toggleAggiorna">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="40"/>
              </grid>
            </constraints>
            <properties>
              <font name="SansSerif" size="14" style="1"/>
              <text value="Aggiorna Registro"/>
            </properties>
          </component>
          <component id="tgCon1" class="javax.swing.JToggleButton" binding="toggleConsulta">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="200" height="40"/>
              </grid>
            </constraints>
            <properties>
              <font name="SansSerif" size="14" style="1"/>
              <text value="Consulta Registro"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="content1" binding="panelContenuto" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="line">
          <color color="-3355444"/>
        </border>
        <children/>
      </grid>
    </children>
  </grid>
</form>
