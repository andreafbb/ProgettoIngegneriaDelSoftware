<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="boundary.FormVisualizzazioneProfilo">
  <grid id="root1" binding="panel1" default-binding="true" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="10">
    <margin top="20" left="30" bottom="20" right="30"/>
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties/>
    <border type="none" title=""/>
    <children>
      <component id="btnBack1" class="javax.swing.JButton" binding="buttonBack">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
            <preferred-size width="80" height="24"/>
          </grid>
        </constraints>
        <properties>
          <font name="SansSerif" size="12"/>
          <text value="Indietro"/>
        </properties>
      </component>
      <component id="lblProf1" class="javax.swing.JLabel" binding="labelProfilo">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="7" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="SansSerif" size="22" style="1"/>
          <horizontalAlignment value="0"/>
          <text value="Profilo"/>
        </properties>
      </component>
      <grid id="subbar2" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="true" same-size-vertically="false" hgap="0" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="tgLezz" class="javax.swing.JToggleButton" binding="toggleLezioni">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="95" height="22"/>
              </grid>
            </constraints>
            <properties>
              <font name="SansSerif" size="11" style="1"/>
              <text value="Lezioni"/>
            </properties>
          </component>
          <component id="tgComp" class="javax.swing.JToggleButton" binding="toggleCompiti">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="95" height="22"/>
              </grid>
            </constraints>
            <properties>
              <font name="SansSerif" size="11" style="1"/>
              <text value="Compiti"/>
            </properties>
          </component>
          <component id="tgValu" class="javax.swing.JToggleButton" binding="toggleValutazioni">
            <constraints>
              <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="95" height="22"/>
              </grid>
            </constraints>
            <properties>
              <font name="SansSerif" size="11" style="1"/>
              <text value="Valutazioni"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="contentProf" binding="panelContenuto" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="3" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="line">
          <color color="-3355444"/>
        </border>
        <children/>
      </grid>
    </children>
  </grid>
</form>
