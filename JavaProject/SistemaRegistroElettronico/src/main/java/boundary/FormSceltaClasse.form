<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="boundary.FormSceltaClasse">
  <grid id="root1" binding="panel1" default-binding="true" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="0" vgap="20">
    <margin top="25" left="30" bottom="25" right="30"/>
    <constraints>
      <xy x="20" y="20" width="420" height="240"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <component id="ttlSC" class="javax.swing.JLabel">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <font name="SansSerif" size="20" style="1"/>
          <text value="Seleziona la Classe"/>
        </properties>
      </component>
      <grid id="rowSC" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="lblSC" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="14"/>
              <text value="Classe:"/>
            </properties>
          </component>
          <component id="cmbSC" class="javax.swing.JComboBox" binding="comboClasse">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <font name="SansSerif" size="14"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="btnSC" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="15" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="bAnnSC" class="javax.swing.JButton" binding="buttonAnnulla">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="120" height="35"/>
              </grid>
            </constraints>
            <properties>
              <font name="SansSerif" size="14"/>
              <text value="Annulla"/>
            </properties>
          </component>
          <component id="bConfSC" class="javax.swing.JButton" binding="buttonConferma">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="140" height="35"/>
              </grid>
            </constraints>
            <properties>
              <font name="SansSerif" size="14" style="1"/>
              <text value="Conferma"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>